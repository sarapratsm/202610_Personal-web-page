@using MiWebPersonal.Core.Models
@model List<Proyecto>

@{
    ViewData["Title"] = "Home Page";
}

<div class="fondo-rosa text-center">
    <h1 class="display-4">Sara Prats Morales</h1>
    <h2>Desarrolladora de software</h2>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
    <p>
        ¡Bienvenide a mi primera web! Este proyecto pretende ser una iniciación al mundo web totalmente autónomo. He creado otras webs con ayuda de la IA, pero echaba en falta ponerme manos a la obra y entender el paso a paso del desarrollo del código... <br/> Me alegro de que estés acompañándome en esta aventura loca en una época en que todo se hace rápido y con ansias.
    </p>
</div>

<div class="fondo-gris">
    <hr/>
    <h2 class="text-center">Proyectos</h2>
        @if (Model == null || Model.Count == 0)
        {
            <p>No hay proyectos disponibles.</p>
        }
        else
        {
            <div class="row">
                @foreach (var proyecto in Model)
                {
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">@proyecto.Titulo</h5>
                                <p class="card-text">@proyecto.Descripcion</p>
                                <p><strong>Tecnologías:</strong></p>
                                <ul>
                                    @foreach (var tecnologia in proyecto.Tecnologias)
                                    {
                                        <li>@tecnologia.Nombre</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    
</div>


