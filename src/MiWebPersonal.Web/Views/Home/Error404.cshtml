@{
    ViewData["Title"] = "Página no encontrada";
}

<!--He aprendido <a href="https://getbootstrap.com/docs/4.0/content/typography/#display-headings">qué es un display heading</a> -->
<div class="text-center mt-5">
    <h1 class="display-1">404</h1>
    <h2>Página no encontrada</h2>
    <p>¿Te has perdido? La página que estás buscando no existe.</p>

    <div class="my-4">
        <img src="https://http.cat/404"
             alt="Gato 404 Not Found"
             class="img-fluid rounded shadow-lg"
             style="max-width: 480px; width: 100%; height: auto;" />
    </div>

    <a href="/" class="btn btn-primary">Volver al inicio</a>

</div>